  "description": "Web Push for xeplr apps — notifications on a phone or computer even when the app is closed: each person's devices, sending, and the routes to switch a device on or off",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/",
    "migrations/",
    "bin/"
  ],
  "keywords": [
    "push",
    "web-push",
    "notifications",
    "pwa",
    "vapid",
    "xeplr"
  ],
  "author": "xeplr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xeplr/push"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "xeplr-push": "bin/xeplr-push.js"
  },
  "scripts": {
