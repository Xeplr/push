  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "peerDependencies": {
    "express": "^4 || ^5",
    "knex": ">=2"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "express": "^4.21.2"
  }
